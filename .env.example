# ==========================================
# AquaFlow Multi-Tenant SaaS Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="AquaFlow Multi-Tenant SaaS"
SECRET_KEY="change-me-to-a-cryptographically-secure-random-token-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM="HS256"

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aquaflow_db
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/aquaflow_db"
ASYNC_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/aquaflow_db"

# Redis & Celery Background Tasks
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# SaaS Default License Rules
DEFAULT_TRIAL_DAYS=14
DEFAULT_GRACE_PERIOD_DAYS=7

# Super Admin Bootstrap User
SUPER_ADMIN_EMAIL="superadmin@aquaflow.io"
SUPER_ADMIN_PASSWORD="Admin@AquaFlow2026!"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# WhatsApp Business / SMS Gateways
WHATSAPP_API_TOKEN="whatsapp_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="whatsapp_phone_number_id"
SMS_GATEWAY_API_KEY="sms_provider_api_key"

